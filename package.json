{
  "name": "framework",
  "version": "1.0.0",
  "description": "",
  "main": "app.js",
  "scripts": {
    "build": "./node_modules/typescript/bin/tsc",
    "start": "node dist/app.js",
    "bs": "npm run build && npm run start",
    "dev": "ts-node-dev --respawn ./src/app.ts",
    "test": "npm run build && node dist/tester.js",
	"migrate": "npx typeorm-ts-node-commonjs migration:run -d ./src/data-source.ts",
    "migrate:gen": "npx typeorm-ts-node-commonjs -d ./src/data-source.ts migration:generate ./src/migrations/",
	"migrate:down": "npx typeorm-ts-node-commonjs migration:revert -d ./src/data-source.ts"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.9.1",
    "@solana/spl-token": "^0.4.6",
    "@solana/web3.js": "^1.91.7",
    "bs58": "^5.0.0",
    "mysql2": "^3.6.0",
    "node-telegram-bot-api": "^0.61.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@types/node": "^20.4.8",
    "@types/node-telegram-bot-api": "^0.61.7",
    "ts-node-dev": "^2.0.0"
  }
}
